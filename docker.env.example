# The production image defaults to the self-contained demo adapter.
VITE_DATA_ADAPTER=demo
INTEGRITYLENS_PORT=8080

# Set these when building the image against local or hosted Supabase.
# Vite embeds these public values into the compiled image at build time. Rebuild
# the image after changing them. Never add server-side secrets to this file.
# Local Supabase normally uses http://127.0.0.1:54321 because the browser,
# rather than the Nginx container, makes the API requests.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_ASSIGNMENT_ID=
