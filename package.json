{
  "name": "integrity-lens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @integrity/web -- --host 127.0.0.1",
    "build": "npm run typecheck && npm run build -w @integrity/web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-engine.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "prepare:supabase": "node scripts/prepare-supabase-functions.mjs",
    "check:backend": "npm run prepare:supabase && node_modules\\deno\\deno.exe check --config backend/supabase/functions/integrity-api/deno.json backend/supabase/functions/integrity-api/index.ts && node_modules\\deno\\deno.exe check --config backend/supabase/functions/integrity-worker/deno.json backend/supabase/functions/integrity-worker/index.ts",
    "check:migrations": "node scripts/check-migrations.mjs",
    "supabase:deploy": "npm run prepare:supabase && supabase --workdir backend db push && supabase --workdir backend functions deploy integrity-worker --use-api && supabase --workdir backend functions deploy integrity-api --use-api",
    "supabase:start": "supabase --workdir backend start",
    "supabase:stop": "supabase --workdir backend stop",
    "supabase:status": "supabase --workdir backend status",
    "supabase:reset": "supabase --workdir backend db reset",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build -d",
    "docker:dev": "docker compose -f compose.yaml -f compose.dev.yaml up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "0.3.14",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "deno": "2.9.6",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.8",
    "supabase": "2.117.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^4.1.11"
  }
}
